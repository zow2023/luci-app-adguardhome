#!/bin/sh /etc/rc.common
#
# SPDX-License-Identifier: GPL-2.0-only
#

. /usr/share/AdGuardHome/helper.sh

START=19
STOP=89

PROG="/usr/bin/AdGuardHome"
USE_PROCD=1

EXTRA_COMMANDS="do_redirect force_reload isrunning"
EXTRA_HELP="\
	do_redirect	0 or 1
	force_reload
	isrunning"

CONTROL_SCRIPT="/usr/share/AdGuardHome/control.sh"
CRON_FILE="/etc/crontabs/root"


get_tz() {
	SET_TZ=""

	local zonename
	local tz=""

	zonename="$(uci -q get system.@system[0].zonename 2>/dev/null)"

	if [ -n "$zonename" ]; then
		SET_TZ="$zonename"
		return 0
	fi

	for tzfile in /etc/TZ /var/etc/TZ; do
		if [ -e "$tzfile" ]; then
			tz="$(cat "$tzfile" 2>/dev/null)"

			if [ -n "$tz" ]; then
				SET_TZ="$tz"
				return 0
			fi
		fi
	done

	return 0
}


do_crontab() {
	local enabled="$1"
	local crontab="$2"
	local findstr default cronenable cronreload=0

	findstr="/usr/share/AdGuardHome/update_core.sh"
	default="30 3 * * * /usr/share/AdGuardHome/update_core.sh 2>&1"

	#
	# NOTE: ${var//pat/} and ${var:0:1} are Bash-isms.  OpenWrt's
	# busybox ash (ASH_BASH_COMPAT=y) accepts them, but strict POSIX
	# shells (dash) do not.  Use case constructs for portability.
	#
	if [ "$enabled" = "0" ]; then
		cronenable=0
	else
		case "$crontab" in
			*autoupdate*)
				cronenable=1
				;;
			*)
				cronenable=0
				;;
		esac
	fi

	crontab_editor

	[ "$cronreload" -gt 0 ] &&
		/etc/init.d/cron restart

	return 0
}


crontab_editor() {
	local line

	mkdir -p /etc/crontabs
	touch "$CRON_FILE"

	line="$(grep "$findstr" "$CRON_FILE" 2>/dev/null)"

	#
	# A disabled entry starts with '#'; an empty string means the
	# entry is not present at all.
	#
	case "$line" in
		\#*)
			line_comment=1
			;;
		*)
			line_comment=0
			;;
	esac

	if [ "$line_comment" -eq 0 ]; then

		if [ "$cronenable" -eq 1 ]; then

			if [ -z "$line" ]; then
				echo "$default" >> "$CRON_FILE"
				cronreload=$((cronreload + 1))
			fi

		elif [ -n "$line" ]; then

			sed -i "\\,$findstr,d" "$CRON_FILE"
			echo "#$line" >> "$CRON_FILE"
			cronreload=$((cronreload + 1))
		fi

	else

		if [ "$cronenable" -eq 1 ]; then
			sed -i "\\,$findstr,d" "$CRON_FILE"
			echo "${line#\#}" >> "$CRON_FILE"
			cronreload=$((cronreload + 1))
		fi

	fi
}


boot() {
	ADGUARDHOME_BOOT=1
	start "$@"
}


start_service() {
	mkdir -p /var/etc

	[ -f /var/etc/adguardhome.nft ] ||
		touch /var/etc/adguardhome.nft

	chmod 644 /var/etc/adguardhome.nft

	#
	# During boot, wait for interface trigger.
	#
	if [ -n "$ADGUARDHOME_BOOT" ]; then
		return 0
	fi

	rm -f /var/run/AdGserverdis 2>/dev/null

	config_load "adguardhome"

	local config_name="config"

	local config_file
	local config
	local group
	local user
	local verbose
	local work_dir
	local workdir

	local gc
	local maxprocs
	local memlimit

	local enabled
	local hashpass
	local crontab
	local redirect
	local http_address


	uci_validate_section "adguardhome" "adguardhome" "$config_name" \
		"gc:uinteger:0" \
		"group:string:adguardhome" \
		"config:string" \
		"config_file:string:/etc/adguardhome/adguardhome.yaml" \
		"jail_mount:list(string)" \
		"jail_mount_rw:list(string)" \
		"maxprocs:uinteger:0" \
		"memlimit:uinteger:0" \
		"user:string:adguardhome" \
		"verbose:bool:0" \
		"workdir:string" \
		"work_dir:string:/var/lib/adguardhome" \
		"enabled:bool:0" \
		"hashpass:string" \
		"crontab:string" \
		"redirect:string:none" \
		"http_address:string"


	#
	# Compatibility with older configurations.
	#
	[ -n "$config" ] &&
		config_file="$config"

	[ -n "$workdir" ] &&
		work_dir="$workdir"


	#
	# Synchronize WebUI password to YAML.
	#
	if [ -n "$hashpass" ]; then

		if [ -f "$config_file" ]; then
			if ! config_editor \
				"users.password" \
				"$hashpass" \
				"$config_file"; then

				logger -t adguardhome \
					"failed to update users.password"
			fi
		fi

		uci set adguardhome."$config_name".hashpass=""
		uci commit adguardhome
	fi


	#
	# Synchronize WebUI listening address to YAML.
	#
	if [ -n "$http_address" ]; then

		if [ -f "$config_file" ]; then
			if ! config_editor \
				"http.address" \
				"$http_address" \
				"$config_file"; then

				logger -t adguardhome \
					"failed to update http.address"
			fi
		fi

		uci set adguardhome."$config_name".http_address=""
		uci commit adguardhome
	fi


	do_crontab "$enabled" "$crontab"


	#
	# Disabled:
	# do not create the procd instance.
	#
	if [ "$enabled" = "0" ]; then
		"$CONTROL_SCRIPT" 0
		return 0
	fi


	#
	# Ensure service user exists.
	#
	if [ "$user" = "adguardhome" ] &&
		! grep -q "^adguardhome:" /etc/passwd; then

		echo \
			"luci-app: User 'adguardhome' is missing, injecting UID 853 into system files..." \
			>&2

		grep -q "^adguardhome:" /etc/group ||
			echo "adguardhome:x:853:" >> /etc/group

		echo \
			"adguardhome:x:853:853:adguardhome:/var/run/adguardhome:/bin/false" \
			>> /etc/passwd
	fi


	#
	# Prepare directories and permissions.
	#
	local config_dir
	config_dir="$(dirname "$config_file")"

	if [ "$config_dir" = "/etc" ]; then
		echo \
			"AdGuard Home config must be stored in its own directory, and not in /etc" \
			>&2

		return 1
	fi

	mkdir -m 0700 -p "$config_dir"
	chown -R "$user:$group" "$config_dir"

	mkdir -m 0700 -p "$work_dir"
	chown -R "$user:$group" "$work_dir"


	#
	# Missing core:
	# clean redirect first, then download asynchronously.
	#
	if [ ! -f "$PROG" ]; then

		logger -t adguardhome \
			"core binary missing; downloading and waiting for it"

		"$CONTROL_SCRIPT" 0

		/usr/share/AdGuardHome/update_core.sh \
			>/tmp/AdGuardHome_update.log 2>&1 &

		#
		# Same pattern as the "no YAML yet" branch: register a
		# placeholder instance that merely waits for the core
		# binary to appear, then exits.  respawn re-runs
		# watchconfig-start path, which then creates the real
		# AdGuardHome instance - so a fresh install started
		# from LuCI comes up without any manual terminal step.
		#
		procd_open_instance "waitcore"

		procd_set_param command \
			/bin/sh -c "while [ ! -x $PROG ]; do sleep 2; done"

		procd_set_param respawn 3600 1
		procd_set_param stdout 1
		procd_set_param stderr 1

		procd_close_instance

		return 0
	fi


	#
	# ---------------------------------------------------------
	# IMPORTANT:
	#
	# Prepare redirect BEFORE creating the AdGuardHome instance.
	#
	# For exchange mode this changes:
	#
	#     dnsmasq :53 -> :1745
	#
	# BEFORE AdGuardHome is allowed to bind :53.
	#
	# This removes the first-start race:
	#
	#     AGH bind 53
	#     vs
	#     dnsmasq move 53 -> 1745
	#
	# ---------------------------------------------------------
	#
	if [ -f "$config_file" ]; then

		if ! "$CONTROL_SCRIPT" 1; then
			logger -t adguardhome \
				"failed to prepare redirect before service start"

			return 1
		fi

	else

		#
		# No YAML yet.
		# AGH will create it later (setup wizard on :3000).
		#
		# ROOT-CAUSE FIX for "LuCI cannot start on the very first
		# run": this branch used to register only a bare
		# "waitconfig" instance and returned, so *no* AdGuardHome
		# process ever appeared - the LuCI start button looked
		# dead.  watchconfig.sh must exit as soon as the YAML
		# exists; the respawn below then re-runs watchconfig (and
		# thus this whole start path), which will take the
		# full-instance branch above and really start AdGuardHome.
		#
		"$CONTROL_SCRIPT" 0

		if [ "$redirect" != "none" ]; then
			procd_open_instance "waitconfig"

			procd_set_param command \
				"/usr/share/AdGuardHome/watchconfig.sh"

			# Re-run watchconfig if it exits before the YAML
			# exists, so the real instance is created without
			# manual intervention.
			procd_set_param respawn 3600 1
			procd_set_param stdout 1
			procd_set_param stderr 1

			procd_close_instance

			logger -t adguardhome \
				"waiting for $config_file before starting AdGuardHome"
		fi

		return 0
	fi


	#
	# ---------------------------------------------------------
	# procd instance
	# ---------------------------------------------------------
	#
	procd_open_instance adguardhome

	procd_set_param command "$PROG"


	[ "$gc" -le 0 ] ||
		procd_append_param env GOGC="$gc"

	[ "$maxprocs" -le 0 ] ||
		procd_append_param env GOMAXPROCS="$maxprocs"

	[ "$memlimit" -le 0 ] ||
		procd_append_param env GOMEMLIMIT="$memlimit"


	local SET_TZ
	get_tz

	[ -n "$SET_TZ" ] &&
		procd_append_param env TZ="$SET_TZ"


	procd_append_param command \
		--config "$config_file"

	procd_append_param command \
		--logfile syslog


	[ "$verbose" = "1" ] &&
		procd_append_param command --verbose


	procd_append_param command \
		--work-dir "$work_dir"


	procd_set_param file \
		/etc/config/adguardhome \
		"$config_file"

	procd_set_param stdout 1
	procd_set_param stderr 1

	procd_set_param user "$user"
	procd_set_param group "$group"

	procd_set_param capabilities \
		"/etc/capabilities/adguardhome.json"

	procd_set_param no_new_privs 1

	procd_set_param respawn


	#
	# jail
	#
	procd_add_jail adguardhome log procfs

	procd_add_jail_mount_rw "$config_dir"
	procd_add_jail_mount_rw "$work_dir"

	procd_add_jail_mount "/etc/hosts"
	procd_add_jail_mount "/etc/ssl/certs"

	[ -f /etc/TZ ] &&
		procd_add_jail_mount "/etc/TZ"


	config_list_foreach "$config_name" jail_mount \
		procd_add_jail_mount

	config_list_foreach "$config_name" jail_mount_rw \
		procd_add_jail_mount_rw


	procd_close_instance


	#
	# Safety watchdog.
	#
	# If AGH dies immediately, restore redirect state.
	#
	(
		sleep 10

		# Anchor the pattern to the full binary path so pgrep -f
		# cannot match unrelated command lines that merely contain
		# "AdGuardHome" and false-cancel the redirect.
		if ! pgrep -f "^$PROG" >/dev/null 2>&1; then
			logger -t adguardhome \
				"no process in 10s cancel redirect"

			"$CONTROL_SCRIPT" 0
		fi
	) &


	return 0
}


stop_service() {
	config_load "adguardhome"

	local config_name="config"
	local crontab

	config_get crontab "$config_name" crontab ""

	#
	# procd handles stopping the process.
	# Restore DNS state explicitly.
	#
	"$CONTROL_SCRIPT" 0

	do_crontab 0 "$crontab"

	touch /var/run/AdGserverdis

	return 0
}


do_redirect() {
	"$CONTROL_SCRIPT" "$1"
}


_isrunning() {
	[ ! -f "$PROG" ] &&
		return 2

	pgrep -f "$(basename "$PROG")" >/dev/null 2>&1 &&
		return 0

	return 1
}


isrunning() {
	_isrunning
	local r=$?

	if [ "$r" = "0" ]; then
		echo "running"
	elif [ "$r" = "1" ]; then
		echo "not run"
	else
		echo "no bin"
	fi

	return "$r"
}


force_reload() {
	#
	# If running, ask procd to restart the instance.
	# Otherwise create the instance through start.
	#
	# NOTE: procd_send_signal sends SIGTERM and relies on respawn;
	# it restarts the process but does NOT reload AGH's config.
	# Implement reload_service() if a true config reload is wanted.
	#
	if _isrunning; then
		procd_send_signal adguardhome
	else
		start
	fi
}


service_triggers() {
	procd_add_reload_trigger adguardhome

	if [ -n "$ADGUARDHOME_BOOT" ]; then

		procd_add_raw_trigger \
			"interface.*.up" \
			5000 \
			/etc/init.d/adguardhome restart
	fi
}
