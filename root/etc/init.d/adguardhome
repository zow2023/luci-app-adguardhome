#!/bin/sh /etc/rc.common
#
# SPDX-License-Identifier: GPL-2.0-only
#

. /usr/share/AdGuardHome/helper.sh

START=19
STOP=89

PROG="/usr/bin/AdGuardHome"
USE_PROCD=1

EXTRA_COMMANDS="do_redirect force_reload isrunning"
EXTRA_HELP="\
	do_redirect	0 or 1
	force_reload
	isrunning"

CONTROL_SCRIPT="/usr/share/AdGuardHome/control.sh"
CRON_FILE="/etc/crontabs/root"
CAPABILITIES_FILE="/etc/capabilities/adguardhome.json"


get_tz() {
	SET_TZ=""

	local zonename
	local tz
	local tzfile

	zonename="$(uci -q get system.@system[0].zonename 2>/dev/null)"

	if [ -n "$zonename" ]; then
		SET_TZ="$zonename"
		return 0
	fi

	for tzfile in /etc/TZ /var/etc/TZ; do
		if [ -e "$tzfile" ]; then
			tz="$(cat "$tzfile" 2>/dev/null)"

			if [ -n "$tz" ]; then
				SET_TZ="$tz"
				return 0
			fi
		fi
	done

	return 0
}


do_crontab() {
	local enabled="$1"
	local crontab="$2"
	local findstr default cronenable cronreload=0

	findstr="/usr/share/AdGuardHome/update_core.sh"
	default="30 3 * * * /usr/share/AdGuardHome/update_core.sh 2>&1"

	if [ "$enabled" = "0" ]; then
		cronenable=0
	else
		case "$crontab" in
			*autoupdate*)
				cronenable=1
				;;
			*)
				cronenable=0
				;;
		esac
	fi

	crontab_editor

	[ "$cronreload" -gt 0 ] &&
		/etc/init.d/cron restart

	return 0
}


crontab_editor() {
	local line
	local line_comment=0

	mkdir -p /etc/crontabs
	touch "$CRON_FILE"

	line="$(grep "$findstr" "$CRON_FILE" 2>/dev/null)"

	case "$line" in
		\#*)
			line_comment=1
			;;
		*)
			line_comment=0
			;;
	esac

	if [ "$line_comment" -eq 0 ]; then

		if [ "$cronenable" -eq 1 ]; then

			if [ -z "$line" ]; then
				echo "$default" >> "$CRON_FILE"
				cronreload=$((cronreload + 1))
			fi

		elif [ -n "$line" ]; then

			sed -i "\\,$findstr,d" "$CRON_FILE"
			echo "#$line" >> "$CRON_FILE"
			cronreload=$((cronreload + 1))
		fi

	else

		if [ "$cronenable" -eq 1 ]; then
			sed -i "\\,$findstr,d" "$CRON_FILE"
			echo "${line#\#}" >> "$CRON_FILE"
			cronreload=$((cronreload + 1))
		fi

	fi
}


boot() {
	ADGUARDHOME_BOOT=1

	start "$@"

	#
	# Boot fallback.
	#
	# start_service returns early during boot and relies on the
	# "interface.*.up" raw trigger.  A trigger fired BEFORE this
	# script registers it is never replayed, so on fast-booting
	# devices the service would never come up for this session.
	# Re-check after a generous delay and kick it once.
	#
	(
		sleep 60

		if ! /etc/init.d/adguardhome isrunning >/dev/null 2>&1; then
			logger -t adguardhome \
				"boot fallback: service still down after 60s, restarting"

			/etc/init.d/adguardhome restart
		fi
	) &
}


start_service() {
	mkdir -p /var/etc

	[ -f /var/etc/adguardhome.nft ] ||
		touch /var/etc/adguardhome.nft

	chmod 644 /var/etc/adguardhome.nft

	#
	# During boot, wait for interface trigger.
	#
	if [ -n "$ADGUARDHOME_BOOT" ]; then
		return 0
	fi

	rm -f /var/run/AdGserverdis 2>/dev/null

	config_load "adguardhome"

	#
	# FIX: do not hardcode the section name as "config".
	# If /etc/config/adguardhome was first created by LuCI it may
	# hold an anonymous section (cfgXXXXXX).  Detect it once here.
	#
	local config_name
	config_name="$(
		uci -q show adguardhome 2>/dev/null |
			sed -n 's/^adguardhome\.\([^.]*\)=adguardhome$/\1/p' |
			head -n 1
	)"

	[ -n "$config_name" ] ||
		config_name="config"

	local config_file
	local config
	local group
	local user
	local verbose
	local work_dir
	local workdir

	local gc
	local maxprocs
	local memlimit

	local enabled
	local hashpass
	local crontab
	local redirect
	local http_address


	uci_validate_section "adguardhome" "adguardhome" "$config_name" \
		"gc:uinteger:0" \
		"group:string:adguardhome" \
		"config:string" \
		"config_file:string:/etc/adguardhome/adguardhome.yaml" \
		"jail_mount:list(string)" \
		"jail_mount_rw:list(string)" \
		"maxprocs:uinteger:0" \
		"memlimit:uinteger:0" \
		"user:string:adguardhome" \
		"verbose:bool:0" \
		"workdir:string" \
		"work_dir:string:/var/lib/adguardhome" \
		"enabled:bool:0" \
		"hashpass:string" \
		"crontab:string" \
		"redirect:string:none" \
		"http_address:string"


	#
	# Compatibility with older configurations.
	#
	[ -n "$config" ] &&
		config_file="$config"

	[ -n "$workdir" ] &&
		work_dir="$workdir"


	#
	# Synchronize WebUI password to YAML.
	# FIX: only clear the UCI value after it was actually applied;
	# when the YAML does not exist yet (first-run wizard), keep it
	# so the next start (after the wizard wrote the YAML) applies it.
	#
	if [ -n "$hashpass" ] && [ -f "$config_file" ]; then

		if config_editor \
			"users.password" \
			"$hashpass" \
			"$config_file"; then

			uci set adguardhome."$config_name".hashpass=""
			uci commit adguardhome
		else
			logger -t adguardhome \
				"failed to update users.password"
		fi
	fi


	#
	# Synchronize WebUI listening address to YAML.  Same fix as above.
	#
	if [ -n "$http_address" ] && [ -f "$config_file" ]; then

		if config_editor \
			"http.address" \
			"$http_address" \
			"$config_file"; then

			uci set adguardhome."$config_name".http_address=""
			uci commit adguardhome
		else
			logger -t adguardhome \
				"failed to update http.address"
		fi
	fi


	do_crontab "$enabled" "$crontab"


	#
	# Disabled: do not create the procd instance.
	#
	if [ "$enabled" = "0" ]; then
		"$CONTROL_SCRIPT" 0
		return 0
	fi


	#
	# Ensure service user exists.
	#
	if [ "$user" = "adguardhome" ] &&
		! grep -q "^adguardhome:" /etc/passwd; then

		echo \
			"luci-app: User 'adguardhome' is missing, injecting UID 853 into system files..." \
			>&2

		grep -q "^adguardhome:" /etc/group ||
			echo "adguardhome:x:853:" >> /etc/group

		echo \
			"adguardhome:x:853:853:adguardhome:/var/run/adguardhome:/bin/false" \
			>> /etc/passwd
	fi


	#
	# Prepare directories and permissions.
	#
	local config_dir
	config_dir="$(dirname "$config_file")"

	if [ "$config_dir" = "/etc" ]; then
		echo \
			"AdGuard Home config must be stored in its own directory, and not in /etc" \
			>&2

		return 1
	fi

	mkdir -m 0700 -p "$config_dir"
	chown -R "$user:$group" "$config_dir"

	mkdir -m 0700 -p "$work_dir"
	chown -R "$user:$group" "$work_dir"


	#
	# Missing core: clean redirect first, then download asynchronously.
	#
	if [ ! -f "$PROG" ]; then

		logger -t adguardhome \
			"core binary missing; downloading and waiting for it"

		"$CONTROL_SCRIPT" 0

		if [ ! -f /var/run/update_core ] &&
			[ ! -f /var/run/AdGuardHome_update.pid ]; then

			/usr/share/AdGuardHome/update_core.sh \
				>/tmp/AdGuardHome_update.log 2>&1 &
		fi

		return 0
	fi


	#
	# FIX: redirect failure must NOT abort the service.
	# A missing nft template, a failed fw4 reload or a validation
	# error previously killed the whole start.  Log it and go on:
	# a running AGH without redirect is strictly better than no AGH.
	#
	if [ -f "$config_file" ]; then

		if ! "$CONTROL_SCRIPT" 1; then
			logger -t adguardhome \
				"failed to prepare redirect before service start (continuing without redirect)"
		fi

	else

		#
		# No YAML yet: AGH first-run wizard generates the config on
		# its WebUI (:3000).  Register the real instance and skip
		# redirect for now.
		#
		"$CONTROL_SCRIPT" 0

		logger -t adguardhome \
			"config file not found; starting first-run setup, redirect will be applied on next start"

		#
		# FIX: auto-link after wizard completion.
		# When the wizard writes the YAML nothing used to trigger
		# the redirect/restart path, so exchange/upstream modes never
		# engaged on the first run.  Spawn a bounded waiter (max 15
		# minutes) that restarts the service once the YAML appears.
		#
		if [ ! -f /var/run/adguardhome.waitwizard ]; then

			: > /var/run/adguardhome.waitwizard

			(
				local i

				for i in $(seq 1 90); do
					[ -f "$config_file" ] || {
						sleep 10
						continue
					}

					# Give AGH a moment to finish writing.
					sleep 3

					logger -t adguardhome \
						"config file appeared after wizard, restarting to apply redirect"

					rm -f /var/run/adguardhome.waitwizard
					/etc/init.d/adguardhome restart
					exit 0
				done

				rm -f /var/run/adguardhome.waitwizard
				logger -t adguardhome \
					"wizard wait timed out; run 'service adguardhome restart' manually"
			) &
		fi
	fi


	#
	# procd instance
	#
	procd_open_instance adguardhome

	procd_set_param command "$PROG"


	[ "$gc" -le 0 ] ||
		procd_append_param env GOGC="$gc"

	[ "$maxprocs" -le 0 ] ||
		procd_append_param env GOMAXPROCS="$maxprocs"

	[ "$memlimit" -le 0 ] ||
		procd_append_param env GOMEMLIMIT="$memlimit"


	local SET_TZ
	get_tz

	[ -n "$SET_TZ" ] &&
		procd_append_param env TZ="$SET_TZ"


	procd_append_param command \
		--config "$config_file"

	procd_append_param command \
		--logfile syslog


	[ "$verbose" = "1" ] &&
		procd_append_param command --verbose


	procd_append_param command \
		--work-dir "$work_dir"


	procd_set_param file \
		/etc/config/adguardhome \
		"$config_file"

	procd_set_param stdout 1
	procd_set_param stderr 1

	procd_set_param user "$user"
	procd_set_param group "$group"

	#
	# FIX: warn loudly when the capabilities file is absent.
	# Running as UID 853 with no_new_privs and no CAP_NET_BIND_SERVICE
	# means AGH cannot bind :53 -> instant exit -> respawn loop ->
	# "sometimes it just does not come up".  Ship the json file
	# (/etc/capabilities/adguardhome.json) with the package.
	#
	if [ -f "$CAPABILITIES_FILE" ]; then
		procd_set_param capabilities "$CAPABILITIES_FILE"
	else
		logger -t adguardhome \
			"WARNING: $CAPABILITIES_FILE missing; binding ports below 1024 as user '$user' WILL FAIL"
	fi

	procd_set_param no_new_privs 1

	procd_set_param respawn


	#
	# jail
	#
	procd_add_jail adguardhome log procfs

	procd_add_jail_mount_rw "$config_dir"
	procd_add_jail_mount_rw "$work_dir"

	procd_add_jail_mount "/etc/hosts"
	procd_add_jail_mount "/etc/ssl/certs"

	[ -f /etc/TZ ] &&
		procd_add_jail_mount "/etc/TZ"


	config_list_foreach "$config_name" jail_mount \
		procd_add_jail_mount

	config_list_foreach "$config_name" jail_mount_rw \
		procd_add_jail_mount_rw


	procd_close_instance


	#
	# Safety watchdog.
	# If AGH dies immediately, restore redirect state.
	# FIX: 20s instead of 10s (slow devices / respawn interval).
	#
	(
		sleep 20

		if ! pgrep -f "^$PROG" >/dev/null 2>&1; then
			logger -t adguardhome \
				"no process in 20s cancel redirect"

			"$CONTROL_SCRIPT" 0
		fi
	) &


	return 0
}


stop_service() {
	config_load "adguardhome"

	local config_name="config"
	local crontab

	#
	# FIX: locate the real section name (see start_service).
	#
	config_name="$(
		uci -q show adguardhome 2>/dev/null |
			sed -n 's/^adguardhome\.\([^.]*\)=adguardhome$/\1/p' |
			head -n 1
	)"

	[ -n "$config_name" ] ||
		config_name="config"

	config_get crontab "$config_name" crontab ""

	#
	# procd handles stopping the process.
	# Restore DNS state explicitly.
	#
	"$CONTROL_SCRIPT" 0

	do_crontab 0 "$crontab"

	touch /var/run/AdGserverdis

	return 0
}


do_redirect() {
	"$CONTROL_SCRIPT" "$1"
}


_isrunning() {
	[ ! -f "$PROG" ] &&
		return 2

	pgrep -f "^$PROG" >/dev/null 2>&1 &&
		return 0

	return 1
}


isrunning() {
	_isrunning
	local r=$?

	if [ "$r" = "0" ]; then
		echo "running"
	elif [ "$r" = "1" ]; then
		echo "not run"
	else
		echo "no bin"
	fi

	return "$r"
}


force_reload() {
	if _isrunning; then
		procd_send_signal adguardhome
	else
		start
	fi
}


service_triggers() {
	procd_add_reload_trigger adguardhome

	if [ -n "$ADGUARDHOME_BOOT" ]; then

		procd_add_raw_trigger \
			"interface.*.up" \
			5000 \
			/etc/init.d/adguardhome restart
	fi
}


# ---------------------------------------------------------------------------
# FIX: 当服务处于未运行状态时, LuCI 的 apply (调用 reload) 应直接 start
# 而不是走默认的 stop + start, 避免对未注册服务 stop 导致 ubus 报错。
# ---------------------------------------------------------------------------
reload_service() {
	if _isrunning; then
		stop
		start
	else
		start
	fi

	return 0
}
